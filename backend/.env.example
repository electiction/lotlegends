# Copy to backend/.env (or set in Render → Environment) and edit.
# Never commit a real .env to git.

# ─── Required in production ─────────────────────────────────────
# Set to "production" on Render to enforce strict secret checks.
LOTLEGENDS_ENV=dev

# Long random string. Used to sign JWT tokens. Min 32 chars in production.
# Generate one with:   python -c "import secrets; print(secrets.token_urlsafe(48))"
LOTLEGENDS_SECRET=replace-this-with-a-long-random-string-at-least-32-chars

# ─── Database ───────────────────────────────────────────────────
# Local SQLite is the default. On Render, set this to your Postgres URL —
# Render provides a "Internal Database URL" you can paste as-is.
# DATABASE_URL=postgres://user:pass@host:5432/lotlegends
# (the app auto-rewrites postgres:// → postgresql+psycopg2:// for SQLAlchemy)

# ─── CORS ───────────────────────────────────────────────────────
# Comma-separated origins. Leave unset for "*" (fine when frontend & API
# share the same domain — which is our case on Render).
# LOTLEGENDS_ALLOWED_ORIGINS=https://lotlegends.com,https://www.lotlegends.com

# ─── Bootstrap admin ────────────────────────────────────────────
# On first startup, the app will create (or promote) this user as admin.
# Use a strong password and rotate it after you log in once.
BOOTSTRAP_ADMIN_EMAIL=chris@lotlegends.dev
BOOTSTRAP_ADMIN_PASSWORD=change-me-please-use-a-strong-password
BOOTSTRAP_ADMIN_NAME=Chris

# ─── Misc ───────────────────────────────────────────────────────
# LOTLEGENDS_LOG_LEVEL=INFO
